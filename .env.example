APP_NAME="The Gift Expert"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

REDIS_HOST=redis

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info.vinothpandiyan@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Fake discovery is local/testing only. Production must set web_research.
CATALOG_CANDIDATE_DISCOVERY_PROVIDER=fake

# Live Tavily search is retrieval-only. Do not commit a real key.
CATALOG_CANDIDATE_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Commercial sourcing (19D.1). Partner-domain Tavily search only; does not create gifts.
COMMERCIAL_SOURCING_SEARCH_PROVIDER=tavily

# 19D.2 affiliate URL builder. Leave empty until the operator documents the network parameter.
# Do not invent marketplace-specific formats in application code.
COMMERCIAL_SOURCING_AMAZON_IN_AFFILIATE_PARAM=
COMMERCIAL_SOURCING_AMAZON_IN_AFFILIATE_VALUE=

# Grounded synthesis (19C.2B). Do not commit a real key. OPENAI_MODEL is required when using web_research.
CATALOG_CANDIDATE_SYNTHESIS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=