<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="CATALOG_CANDIDATE_DISCOVERY_PROVIDER" value="fake"/>
        <env name="CATALOG_CANDIDATE_SEARCH_PROVIDER" value="tavily"/>
        <env name="TAVILY_API_KEY" value=""/>
        <env name="OPENAI_API_KEY" value=""/>
        <env name="OPENAI_MODEL" value=""/>
        <!--
            Recipient eligibility is pinned to the shipped defaults (strict mode) so a
            developer's .env or shell never changes test results. Tests that need
            inference enable it explicitly (Tests\Support\ConfiguresRecipientEligibility).
        -->
        <env name="RECIPIENT_ELIGIBILITY_ENABLED" value="false" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_SHADOW" value="false" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_SHADOW_SAMPLE_RATE" value="0.1" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_SURFACE_RELATIONSHIP" value="off" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_SURFACE_OCCASION" value="off" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_SURFACE_CATEGORY" value="off" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_SURFACE_INTEREST" value="off" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_SURFACE_GIFT_TYPE" value="off" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_SURFACE_PROFESSION" value="off" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_SURFACE_GIFT_IDEAS" value="off" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_FINDER" value="off" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_EXPLICIT_CONTRADICTIONS" value="off" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_FINDER_AUDIENCE" value="false" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_POOL_ORDERING" value="false" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_INFERRED_WEIGHT" value="6" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_INFER_HUSBAND" value="false" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_INFER_BOYFRIEND" value="false" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_INFER_WIFE" value="false" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_INFER_GIRLFRIEND" value="false" force="true"/>
        <env name="RECIPIENT_ELIGIBILITY_REQUIRE_REVIEW_GATE" value="true" force="true"/>
    </php>
</phpunit>
